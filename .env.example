# Where the site loads manifest.json and images from (no trailing slash).
# Dev default (unset): /generated, served by the Vite dev server from ./generated
# Production (set in Cloudflare Pages > Settings > Environment variables):
VITE_IMAGE_BASE=https://img.textures.lttl.info

# For `npm run upload` (Cloudflare R2, S3-compatible API). Create an R2 API token with
# "Object Read & Write" on the bucket. Never commit the real .env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=surfaces-images
